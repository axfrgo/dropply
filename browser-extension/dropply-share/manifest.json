{
  "manifest_version": 3,
  "name": "Dropply Share",
  "version": "1.0.0",
  "description": "Send the current chat or page into Dropply as a Smart Drop with source context.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:45123/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to Dropply",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
